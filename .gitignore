# --- Rust / Cargo ---
# Cargo.lock is intentionally committed: this workspace ships an application
# (the Tauri app), and applications should pin exact dependency versions.
/target/
**/target/

# --- Node / frontend ---
node_modules/
dist/
.vite/
*.tsbuildinfo

# --- Tauri ---
src-tauri/target/
src-tauri/gen/

# --- Sidecar binaries (built fresh by CI - see .github/workflows/build-sidecars.yml
# and resources/bin/README.md - never committed) ---
resources/bin/*
!resources/bin/README.md
# Generated -c override merging externalBin+resources at sidecar-build time
# (see release.yml) - never committed, regenerated fresh each build.
src-tauri/sidecar-config.json

# --- Never commit real data ---
# fixtures/ holds only tiny synthetic databases checked in on purpose.
*.amber
chat.db
chat.db-wal
chat.db-shm
Manifest.plist
Info.plist
Status.plist
*.mbdb
*.mbdx

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# --- Claude Code session state (worktrees, locks) ---
.claude/

# --- Secrets ---
.env
.env.*
*.pem
*.p12
*.mobileprovision
